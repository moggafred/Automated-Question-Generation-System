# ---------------------------------------------------------------------------
# AQG — AI-Powered Educational Assessment and Study Platform
#
# Copy this file to `.env` and adjust. Every value below is optional: with no
# configuration at all the app boots in development mode, but generation needs
# a real AI provider key (see LLM Providers below).
# ---------------------------------------------------------------------------

# --- Identity --------------------------------------------------------------
APP_NAME="AQG"
APP_TAGLINE="Automated Question Generation"

# --- Runtime ---------------------------------------------------------------
# Keep DEBUG=False outside local development: it enables verbose logging and
# disables the production-safety defaults.
DEBUG=False
PORT=8000

# --- Uploads ---------------------------------------------------------------
# Maximum upload size in bytes (10MB default).
MAX_UPLOAD_SIZE=10485760
# Comma-separated, dot-prefixed whitelist enforced on both server and client.
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt
# Documents with fewer words than this are rejected as empty.
MIN_DOCUMENT_WORDS=5

# --- Persistence -----------------------------------------------------------
# SQLite file for documents, assessments, study materials and attempts.
# Relative paths resolve against the project root, so "quizzes.db" is portable
# across working directories.
DATABASE_PATH=quizzes.db

# --- Generation bounds -----------------------------------------------------
# The client reads these from GET /api/limits, so the UI never hardcodes them.
MIN_QUESTIONS=1
MAX_QUESTIONS=20
DEFAULT_QUESTIONS=5
MAX_TOPIC_LENGTH=200
MAX_INSTRUCTIONS_LENGTH=1500

# --- AI providers ----------------------------------------------------------
# LLM_PROVIDER: "openai" for hosted APIs, "local" for a self-hosted server.
LLM_PROVIDER=openai

# Hosted provider. Any OpenAI-compatible gateway works via LLM_BASE_URL.
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o
# Optional gateway base URL, e.g. https://openrouter.ai/api/v1 — leave blank
# to call OpenAI directly.
LLM_BASE_URL=
# Lower values produce more literal, document-grounded questions.
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2

# Self-hosted fallback (LLM_PROVIDER=local). Point at a vLLM or Ollama server
# exposing an OpenAI-compatible /v1 endpoint.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Retrieval-Augmented Generation ---------------------------------------
# How many ranked passages are handed to the model per generation request.
# Higher values cost more tokens and can dilute focus.
RAG_TOP_K=5
# Dimensionality of the hashing bag-of-words embedding layer.
RAG_EMBED_DIM=512
# Chunking: character size and overlap used to split extracted document text.
RAG_CHUNK_SIZE=220
RAG_CHUNK_OVERLAP=40
# Hard ceiling on the context string sent to the model.
RAG_MAX_CONTEXT_CHARS=12000

# --- Study materials -------------------------------------------------------
# Caps applied to generated study resources.
MAX_FLASHCARDS=20
MAX_KEY_CONCEPTS=12

# --- Security --------------------------------------------------------------
# Sliding-window rate limit per client IP. Static assets and /api/status are
# exempt so page loads never consume the API budget.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# --- Authentication / sessions ---------------------------------------------
# Signing material for opaque session identifiers. Generate a strong value for
# production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# When blank a per-process value is derived, which is fine only for local dev.
AUTH_SECRET_KEY=
SESSION_COOKIE_NAME=aqg_session
CSRF_COOKIE_NAME=aqg_csrf
# Session lifetime in seconds (default 7 days) and in-flight OAuth state TTL.
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
# Set to True on any HTTPS deployment so cookies are only sent over TLS.
SESSION_COOKIE_SECURE=False
# lax keeps same-site navigations (including the OAuth redirect) working.
SESSION_COOKIE_SAMESITE=lax

# --- Email + password accounts ---------------------------------------------
EMAIL_PASSWORD_ENABLED=True
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# --- Google OAuth 2.0 / OpenID Connect -------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials and
# register the redirect URI exactly as shown:
#   https://YOUR-BACKEND-HOST/api/auth/google/callback
#   http://localhost:8000/api/auth/google/callback   (development)
# Leave both blank to disable the Google button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit redirect URI; blank derives it from the request URL.
GOOGLE_REDIRECT_URI=

# --- Deployment / cross-origin ---------------------------------------------
# Absolute URL users return to after OAuth. Blank means "same origin". When the
# SPA is hosted on a different domain (e.g. Vercel) set both of these.
FRONTEND_URL=
# Comma-separated browser origins allowed to call the API directly. If left
# blank it falls back to FRONTEND_URL. Never use "*" with credentials.
ALLOWED_ORIGINS=
# Trust X-Forwarded-* headers from a TLS-terminating proxy (Vercel/Render).
TRUST_PROXY_HEADERS=True