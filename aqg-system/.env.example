# Application Settings
APP_NAME="Automated Question Generation System"
DEBUG=False
PORT=8000
# Maximum upload size in bytes (defaults to 10MB)
MAX_UPLOAD_SIZE=10485760

# LLM Providers Configuration
# Set OPENAI_API_KEY if using cloud APIs, or change BASE_URL for local vLLM/Ollama execution
# Providers: "openai" (cloud GPT-4o / Claude via compatible gateway) or "local" (vLLM/Ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o
# Optional OpenAI-compatible gateway endpoint (e.g. https://openrouter.ai/api/v1)
LLM_BASE_URL=

# Local Self-Hosted Privacy fallback (LLM_PROVIDER=local)
# Point at your vLLM server (ServingEngine). OpenAI-compatible /v1 endpoint.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Retrieval-Augmented Generation (RAG) parameters
# Number of top semantically relevant chunks pulled from the FAISS index per generation request.
RAG_TOP_K=3
# Dimensionality of the in-memory hashing bag-of-words embedding layer.
RAG_EMBED_DIM=512